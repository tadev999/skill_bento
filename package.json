{
  "name": "skill-bento",
  "publisher": "skillbento-local",
  "displayName": "SkillBento",
  "description": "Local SkillBento skills launcher and workflow history",
  "version": "0.2.3",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:skillbento.catalog",
    "onView:skillbento.history"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "main": "./hub.js",
  "contributes": {
    "commands": [
      {
        "command": "skillbento.open",
        "title": "SkillBento: Open Skills Hub",
        "icon": "$(tools)"
      },
      {
        "command": "skillbento.run",
        "title": "SkillBento: Run Skill",
        "icon": "$(play)"
      },
      {
        "command": "skillbento.refresh",
        "title": "SkillBento: Refresh Skills",
        "icon": "$(refresh)"
      },
      {
        "command": "skillbento.filters",
        "title": "SkillBento: Select Role and Platform",
        "icon": "$(filter)"
      },
      {
        "command": "skillbento.search",
        "title": "SkillBento: Search Skills",
        "icon": "$(search)"
      },
      {
        "command": "skillbento.resetFilters",
        "title": "SkillBento: Clear Search and Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "skillbento.details",
        "title": "SkillBento: Open Skill Definition",
        "icon": "$(book)"
      },
      {
        "command": "skillbento.update",
        "title": "SkillBento: Update Run Status",
        "icon": "$(edit)"
      },
      {
        "command": "skillbento.result",
        "title": "SkillBento: Open Run Details and Results",
        "icon": "$(output)"
      },
      {
        "command": "skillbento.cancelRun",
        "title": "SkillBento: Mark Run as Cancelled",
        "icon": "$(circle-slash)"
      },
      {
        "command": "skillbento.deleteRun",
        "title": "SkillBento: Delete Run from History",
        "icon": "$(trash)"
      },
      {
        "command": "skillbento.copy",
        "title": "SkillBento: Copy Run Prompt",
        "icon": "$(copy)"
      },
      {
        "command": "skillbento.clear",
        "title": "SkillBento: Clear Local Run History",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillbento",
          "title": "SkillBento",
          "icon": "media/skillbento.svg"
        }
      ]
    },
    "views": {
      "skillbento": [
        {
          "id": "skillbento.catalog",
          "name": "Skills",
          "icon": "$(tools)"
        },
        {
          "id": "skillbento.history",
          "name": "Runs",
          "icon": "$(history)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skillbento.catalog",
        "contents": "No matching skills found in workspace.\n\nSkillBento discovers workflow skills defined in `.agents/skills` and `.github/skills`.\n\n[$(clear-all) Reset Filters & Search](command:skillbento.resetFilters)\n[$(refresh) Refresh Skills Catalog](command:skillbento.refresh)\n[$(gear) Configure Skill Roots](command:workbench.action.openSettings?%22skillbento.skillRoots%22)"
      },
      {
        "view": "skillbento.history",
        "contents": "No skill runs recorded yet.\n\nLaunch automated workflow skills with real-time status and artifact tracking.\n\n[$(play) Launch a Skill](command:skillbento.run)\n[$(refresh) Refresh History](command:skillbento.refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillbento.search",
          "when": "view == skillbento.catalog",
          "group": "navigation@1"
        },
        {
          "command": "skillbento.filters",
          "when": "view == skillbento.catalog",
          "group": "navigation@2"
        },
        {
          "command": "skillbento.run",
          "when": "view == skillbento.catalog",
          "group": "navigation@3"
        },
        {
          "command": "skillbento.resetFilters",
          "when": "view == skillbento.catalog",
          "group": "1_catalog@1"
        },
        {
          "command": "skillbento.refresh",
          "when": "view == skillbento.catalog",
          "group": "1_catalog@2"
        },
        {
          "command": "skillbento.run",
          "when": "view == skillbento.history",
          "group": "navigation@1"
        },
        {
          "command": "skillbento.refresh",
          "when": "view == skillbento.history",
          "group": "navigation@2"
        },
        {
          "command": "skillbento.clear",
          "when": "view == skillbento.history",
          "group": "1_history@1"
        }
      ],
      "view/item/context": [
        {
          "command": "skillbento.run",
          "when": "viewItem == skillbentoSkill",
          "group": "inline@1"
        },
        {
          "command": "skillbento.details",
          "when": "viewItem == skillbentoSkill",
          "group": "inline@2"
        },
        {
          "command": "skillbento.result",
          "when": "viewItem == skillbentoRunActive || viewItem == skillbentoRunTerminal",
          "group": "inline@1"
        },
        {
          "command": "skillbento.update",
          "when": "viewItem == skillbentoRunActive || viewItem == skillbentoRunTerminal",
          "group": "inline@2"
        },
        {
          "command": "skillbento.copy",
          "when": "viewItem == skillbentoRunActive || viewItem == skillbentoRunTerminal",
          "group": "inline@3"
        },
        {
          "command": "skillbento.cancelRun",
          "when": "viewItem == skillbentoRunActive",
          "group": "2_run"
        },
        {
          "command": "skillbento.deleteRun",
          "when": "viewItem == skillbentoRunTerminal",
          "group": "2_run"
        }
      ]
    },
    "configuration": {
      "title": "SkillBento",
      "properties": {
        "skillbento.skillRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional absolute skills-directory paths. Workspace repositories and immediate child repositories are discovered automatically."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "skillbento_updateRun",
        "toolReferenceName": "skillbentoUpdateRun",
        "displayName": "Update SkillBento Run Status",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Update a local SkillBento run using the exact runId supplied by the launch prompt. Report real progress, blockers, approval needs, and evidence. Completion does not mean tests passed or changes were approved.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "running",
                "pending_evidence",
                "needs_approval",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "summary": {
              "type": "string",
              "description": "Actual progress or evidence, not an inferred result."
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Existing file paths relative to the run repository."
            }
          },
          "required": [
            "runId",
            "status",
            "summary"
          ]
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node --test test/core.test.js test/host.test.js",
    "test:integration": "vscode-test",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "globals": "^16.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
